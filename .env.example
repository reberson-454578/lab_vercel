# Copie este arquivo para .env e preencha os valores reais.
# O .env NÃO é enviado pro Git nem pra Vercel — ele serve só pra rodar localmente.
# Em produção, configure essas mesmas variáveis no painel da Vercel.

# ----- Banco de dados (Neon Postgres) -----
# Pegue em: vercel dashboard -> Storage -> seu banco Neon -> ".env.local"
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/banco?sslmode=require

# ----- Vercel Blob (storage de arquivos) -----
# Criado automaticamente quando você adiciona Blob Storage no projeto Vercel.
# Pegue em: vercel dashboard -> Storage -> seu Blob -> "Tokens"
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXXXXXXXXXXXXXXX

# ----- Chave de assinatura dos cookies de sessão -----
# Use uma string longa e aleatória. Em terminal Linux/Mac:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-isto-por-uma-string-longa-e-aleatoria
